---
import Icon from './Icon.astro';
import { images } from '../data/site';
import { hl, type Dict } from '../i18n';

interface Props {
	t: Dict;
	bookHref: string;
	secondHref: string;
	secondLabel: string;
}
const { t, bookHref, secondHref, secondLabel } = Astro.props;
---

<section class="cta-wrap">
	<div class="container">
		<div class="cta-band" style={`--cta-img:url('${images.cta}')`}>
			<h2>{t.cta.title}</h2>
			<p set:html={hl(t.cta.text, t)} />
			<div class="row">
				<a class="btn btn-green btn-lg" href={bookHref}><Icon name="ticket" size={18} />{t.cta.book}</a>
				<a class="btn btn-light" href={secondHref}>{secondLabel}</a>
			</div>
		</div>
	</div>
</section>
