---
// Khung chung cho mọi bài viết: chỉ khác nhau ở chuyên mục (dịch vụ / cẩm nang / tin tức)
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import { site } from '../data/site';
import { getDict, pagePath, catPath, assetPath, hl, type Lang } from '../i18n';
import { postsFor, postUrl, translationsOf, type Post } from '../lib/blog';

interface Props {
	post: Post;
	lang: Lang;
}
const { post, lang } = Astro.props;
const t = getDict(lang);
const d = post.data;
const { Content } = await render(post);
const home = pagePath(lang, 'home');
const blog = pagePath(lang, 'blog');
const cat = catPath(lang, d.category);
const catName = t.blog.cats[d.category];
const url = postUrl(post);
const abs = (p: string) => new URL(p, Astro.site).href;

// Chỉ gắn hreflang cho bản dịch thật sự có
const translations = await translationsOf(post);
const alternates = Object.fromEntries(translations.map((p) => [p.data.lang, postUrl(p)]));

const all = await postsFor(lang);
const related = [...all.filter((p) => p.id !== post.id && p.data.category === d.category), ...all.filter((p) => p.data.category !== d.category)].slice(0, 2);
const dateIso = d.date.toISOString().slice(0, 10);

const jsonLd: object[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: d.title,
		description: d.description,
		image: [d.cover],
		datePublished: dateIso,
		dateModified: (d.updated ?? d.date).toISOString().slice(0, 10),
		inLanguage: t.htmlLang,
		articleSection: catName,
		keywords: d.keywords.join(', '),
		mainEntityOfPage: { '@type': 'WebPage', '@id': abs(url) },
		author: { '@type': 'Organization', name: site.brand, url: abs(home) },
		publisher: { '@type': 'Organization', name: site.brand, logo: { '@type': 'ImageObject', url: abs(assetPath(site.logo)) } },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: t.nav.home, item: abs(home) },
			{ '@type': 'ListItem', position: 2, name: catName, item: abs(cat) },
			{ '@type': 'ListItem', position: 3, name: d.title, item: abs(url) },
		],
	},
];
if (d.faq?.length) {
	jsonLd.push({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: d.faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })),
	});
}
---

<Base lang={lang} page="post" title={`${d.title} | ${site.brand}`} description={d.description} keywords={d.keywords} alternates={alternates} jsonLd={jsonLd} ogType="article" noindex={!d.reviewed}>
	<article class="post">
		<header class="post-head">
			<div class="container narrow">
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href={home}>{t.nav.home}</a><span>/</span><a href={blog}>{t.nav.blog}</a><span>/</span><a href={cat}>{catName}</a>
				</nav>
				<a class:list={['chip', d.category]} href={cat}>{catName}</a>
				<h1>{d.title}</h1>
				<p class="post-meta">{t.blog.published} <time datetime={dateIso}>{d.date.toLocaleDateString(t.locale, { day: '2-digit', month: '2-digit', year: 'numeric' })}</time> · {site.brand}</p>
			</div>
		</header>
		<div class="container narrow">
			<img class="post-cover" src={d.cover} alt={d.coverAlt} width="1200" height="630" fetchpriority="high" />
			<div class="prose">
				<Content />
			</div>
			{d.faq?.length ? (
				<section class="post-faq">
					<h2>{t.faq.title}</h2>
					{d.faq.map((x) => <details><summary>{x.q}</summary><p set:html={hl(x.a, t)} /></details>)}
				</section>
			) : null}
			<aside class="post-cta">
				<div>
					<b set:html={hl(t.blog.ctaTitle, t)} />
					<p>{t.blog.ctaText}</p>
				</div>
				<a class="btn btn-green btn-lg" href={`${home}#book`}><Icon name="ticket" size={18} />{t.blog.ctaBtn}</a>
			</aside>
			<p><a class="link" href={cat}>← {catName}</a></p>
		</div>
	</article>

	{related.length > 0 && (
		<section class="related">
			<div class="container">
				<h2>{t.blog.related}</h2>
				<div class="post-grid">{related.map((p) => <PostCard post={p} lang={lang} />)}</div>
			</div>
		</section>
	)}
</Base>
