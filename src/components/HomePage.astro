---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import ProcessSteps from './ProcessSteps.astro';
import WhyGrid from './WhyGrid.astro';
import PostCard from './PostCard.astro';
import { site, images, stops, ticketPrice } from '../data/site';
import { getDict, langs, categories, pagePath, catPath, assetPath, hl, type Lang } from '../i18n';
import { postsFor } from '../lib/blog';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
const f = t.form;
const r = t.routes;
const c = site.contact;
const hotlineTel = c.hotline.split(' ').join('');
// Khung giờ đón: 05:00 đến 23:00, cách nhau 30 phút
const slots = Array.from({ length: 37 }, (_, i) => {
	const m = 300 + i * 30;
	return String(Math.floor(m / 60)).padStart(2, '0') + ':' + (m % 60 === 0 ? '00' : '30');
});

const km = (n: number) => n.toLocaleString(t.locale) + ' km';
const mapUrl = (q: string) => (q.startsWith('http') ? q : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`);

const posts = await postsFor(lang);
// Trên trang chủ chỉ hiện chuyên mục đã có bài
const homeCats = categories.filter((c) => posts.some((p) => p.data.category === c));

const alternates = Object.fromEntries(langs.map((l) => [l, pagePath(l, 'home')]));
const url = new URL(pagePath(lang, 'home'), Astro.site).href;
const logoUrl = new URL(assetPath(site.logo), Astro.site).href;
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': url + '#website',
		name: site.brand,
		url,
		inLanguage: t.htmlLang,
		publisher: { '@id': url + '#org' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': url + '#org',
		name: site.brand,
		url,
		logo: logoUrl,
		slogan: t.slogan,
		description: t.footer.about,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: t.hero.title,
		serviceType: 'Airport shuttle',
		description: t.meta.home.description,
		provider: { '@id': url + '#org' },
		areaServed: [
			{ '@type': 'City', name: 'Nha Trang' },
			{ '@type': 'Airport', name: 'Cam Ranh International Airport', iataCode: 'CXR' },
		],
		availableChannel: { '@type': 'ServiceChannel', serviceUrl: url + '#book' },
		offers: {
			'@type': 'Offer',
			url: url + '#book',
			priceCurrency: 'VND',
			price: ticketPrice,
			priceSpecification: { '@type': 'UnitPriceSpecification', price: ticketPrice, priceCurrency: 'VND', minPrice: ticketPrice, unitText: 'per person, one way' },
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: t.faq.items.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })),
	},
];
---

<Base lang={lang} page="home" title={t.meta.home.title} description={t.meta.home.description} keywords={t.meta.home.keywords} alternates={alternates} jsonLd={jsonLd}>
	<!-- 1. HERO: bên trái phủ trắng, mờ dần sang phải để lộ ảnh -->
	<section class="hero" style={`--hero-img:url('${assetPath(images.hero)}');--hero-img-m:url('${assetPath(images.heroMobile)}')`} aria-labelledby="hero-title">
		<div class="container">
			<div class="hero-inner">
				<p class="kicker">{t.hero.kicker}</p>
				<h1 id="hero-title">{t.hero.title}</h1>
				<p class="hero-price">
					<span>{t.hero.priceFrom}</span>
					<strong class="price-tag">{t.priceLong}</strong>
					<span class="unit">{t.hero.priceUnit}</span>
				</p>
				<a class="btn btn-green btn-lg" href="#book"><Icon name="ticket" />{t.hero.cta}</a>
				<ul class="hero-chips">
					{t.hero.chips.map((c) => <li><Icon name="trust" size={18} />{c}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<!-- 2. ĐIỂM TRẢ TẠI NHA TRANG (chỉ một chiều: sân bay Cam Ranh → Nha Trang) -->
	<section id="routes" class="routes" aria-labelledby="routes-title">
		<div class="container">
			<SectionHead eyebrow={r.eyebrow} title={r.title} sub={r.sub} center id="routes-title" />

			<div id="stops-panel">
				<div class="stops-grid">
					{stops.filter((s) => s.ready).map((s) => {
						const info = t.stopInfo[s.id];
						return (
							<article class="stop-card">
								<div class="stop-img">
									<img src={s.image} alt={info.name} loading="lazy" width="640" height="400" />
									<span class="stop-tag">{r.dropTag}</span>
								</div>
								<div class="stop-body">
									<h4>{info.name}</h4>
									<p class="addr"><Icon name="pin" size={16} />{info.address}</p>
									<p class="desc">{info.desc}</p>
									{(s.beachKm != null || s.centerKm != null) && (
										<ul class="dist">
											{s.beachKm != null && <li><span>{r.distBeach}</span><b>{km(s.beachKm)}</b></li>}
											{s.centerKm != null && <li><span>{r.distCenter}</span><b>{km(s.centerKm)}</b></li>}
										</ul>
									)}
									<div class="stop-actions">
										{s.ready && <a class="btn btn-green btn-block" href="#book">{r.book}</a>}
										{s.map && <a class="link" href={mapUrl(s.map)} target="_blank" rel="noopener"><Icon name="map" size={16} />{r.map}</a>}
									</div>
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</div>
	</section>

	<!-- 3. SỨ MỆNH -->
	<section id="mission" class="mission band" style={`--band-img:url('${images.mission}')`} aria-labelledby="mission-title">
		<div class="container mission-grid">
			<div class="mission-img"><img src={images.mission} alt="" loading="lazy" width="720" height="540" /></div>
			<div>
				<SectionHead eyebrow={t.mission.eyebrow} title={t.mission.title} light id="mission-title" />
				<p class="lead">{t.mission.text}</p>
				<a class="btn btn-light" href={pagePath(lang, 'about')}>{t.mission.more} <Icon name="arrow" size={18} /></a>
			</div>
		</div>
	</section>

	<!-- 4. QUY TRÌNH -->
	<ProcessSteps t={t} ctaHref="#book" />

	<!-- 5. VÌ SAO CHỌN ORIGO -->
	<WhyGrid t={t} ctaHref="#book" />

	<!-- 6. FORM ĐẶT VÉ: chỉ vài thông tin, còn lại nhân viên tư vấn. Gửi về Google Sheet qua Apps Script (site.formEndpoint) -->
	<section id="book" class="book" aria-labelledby="book-title">
		<div class="container">
			<div class="booking-wrap">
				<div class="book-intro">
					<SectionHead eyebrow={f.eyebrow} title={f.title} sub={f.sub} light id="book-title" />
					<p class="book-price">{f.priceLine} <strong class="price-tag">{t.priceLong}</strong><small>{f.priceUnit}</small></p>
				</div>
				<form
					class="booking"
					id="booking-form"
					data-endpoint={site.formEndpoint}
					data-price={ticketPrice}
					data-locale={t.locale}
					data-currency={f.currency}
					data-estimate-more={f.estimateMore}
					data-phone-err={f.phoneErr}
					data-email-err={f.emailErr}
					data-ok={f.ok}
					data-demo={f.demo}
					data-err={f.err}
					novalidate
				>
					<input type="hidden" name="lang" value={lang} />
					<div class="grid">
						<div class="wide">
							<label for="name">{f.name}</label>
							<input id="name" name="name" type="text" autocomplete="name" placeholder={f.namePh} required maxlength="80" />
						</div>
						<div class="wide">
							<label for="phone">{f.phone}</label>
							<input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder={f.phonePh} required pattern="[0-9+()\s.\-]{8,20}" />
						</div>
						<div class="full">
							<label for="email">{f.email}</label>
							<input id="email" name="email" type="email" autocomplete="email" inputmode="email" placeholder={f.emailPh} required maxlength="120" />
						</div>
						<div class="full">
							<span class="lbl">{f.route}</span>
							<div class="locked-field" aria-readonly="true"><Icon name="plane" size={20} />{t.routeInfo['cxr-to-nha-trang'].from} → {t.routeInfo['cxr-to-nha-trang'].to}</div>
							<input type="hidden" name="route" value="cxr-to-nha-trang" />
						</div>
						<div class="full">
							<label for="origin">{f.origin}</label>
							<input id="origin" name="origin" type="text" placeholder={f.originPh} required maxlength="60" autocomplete="off" />
						</div>
						<div>
							<label for="date">{f.date}</label>
							<input id="date" name="date" type="date" required />
						</div>
						<div>
							<label for="time">{f.time}</label>
							<select id="time" name="time" required aria-describedby="time-hint time-warn">
								<option value="">{f.timeChoose}</option>
								{slots.map((v) => <option value={v}>{v}</option>)}
							</select>
						</div>
						<p class="hint full" id="time-hint">{f.timeHint}</p>
						<p class="warn full" id="time-warn" role="alert" hidden data-msg={`${f.tooSoon} ${c.hotline}`}>{f.tooSoon} <a href={`tel:${hotlineTel}`}>{c.hotline}</a></p>
						<div>
							<label for="people">{f.people}</label>
							<select id="people" name="people" required>
								{Array.from({ length: 9 }, (_, i) => <option value={String(i + 1)}>{i + 1}</option>)}
								<option value="10+">{f.peopleMore}</option>
							</select>
						</div>
						<div>
							<span class="lbl">{f.estimate}</span>
							<output class="estimate" id="estimate" for="people" aria-live="polite">{ticketPrice.toLocaleString(t.locale)} {f.currency}</output>
						</div>
						<!-- honeypot chống bot -->
						<div class="hp" aria-hidden="true">
							<label for="website">{f.honeypot}</label>
							<input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
						</div>
					</div>
					<button class="btn btn-green btn-lg btn-block" type="submit" id="submit-btn"><Icon name="ticket" />{f.submit}</button>
					<p class="privacy">{f.privacy}</p>
				</form>
				<!-- Hộp thoại trạng thái gửi: khóa trang khi đang xử lý, không đóng được bằng bấm ra ngoài hay Esc -->
				<dialog id="status-dialog" class="status-dialog" aria-labelledby="dlg-title" aria-describedby="dlg-text" data-processing={f.processing} data-processing-hint={f.processingHint} data-ok-title={f.okTitle} data-err-title={f.errTitle}>
					<div class="dlg-icon" aria-hidden="true"></div>
					<h3 id="dlg-title"></h3>
					<p id="dlg-text" role="status" aria-live="polite"></p>
					<button type="button" class="btn btn-green" id="dlg-close" hidden>{f.close}</button>
				</dialog>
			</div>
		</div>
	</section>

	<!-- 7. BLOG: theo chuyên mục -->
	<section id="news" class="news" aria-labelledby="news-title">
		<div class="container">
			<SectionHead eyebrow={t.blog.eyebrow} title={t.blog.title} sub={t.blog.sub} center id="news-title" />
			<div class="news-grid">
				{homeCats.map((c) => (
					<div class="news-col">
						<div class="cat-head">
							<h3 class:list={['news-cat', c]}>{t.blog.cats[c]}</h3>
							<a class="more" href={catPath(lang, c)}>{t.blog.all} →</a>
						</div>
						{posts.filter((p) => p.data.category === c).slice(0, 2).map((p) => <PostCard post={p} lang={lang} />)}
					</div>
				))}
			</div>
			{homeCats.length === 0 && <p class="muted center-text">{t.blog.empty}</p>}
			<p class="center-row"><a class="btn btn-light" href={pagePath(lang, 'blog')}>{t.blog.all} <Icon name="arrow" size={18} /></a></p>
		</div>
	</section>

	<!-- 8. HỎI ĐÁP -->
	<section id="faq" class="faq" aria-labelledby="faq-title">
		<div class="container narrow">
			<SectionHead eyebrow={t.faq.eyebrow} title={t.faq.title} center id="faq-title" />
			{t.faq.items.map((x, i) => (
				<details open={i === 0}>
					<summary>{x.q}</summary>
					<p set:html={hl(x.a, t)} />
				</details>
			))}
		</div>
	</section>

	<script>
		const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const form = el<HTMLFormElement>('booking-form');
		const dlg = el<HTMLDialogElement>('status-dialog');
		const dlgTitle = el('dlg-title');
		const dlgText = el('dlg-text');
		const dlgClose = el<HTMLButtonElement>('dlg-close');
		const btn = el<HTMLButtonElement>('submit-btn');
		const phone = el<HTMLInputElement>('phone');
		const emailEl = el<HTMLInputElement>('email');
		const dateEl = el<HTMLInputElement>('date');
		const timeEl = el<HTMLSelectElement>('time');
		const timeWarn = el('time-warn');
		const people = el<HTMLSelectElement>('people');
		const estimate = el('estimate');
		let submitting = false; // chặn bấm gửi nhiều lần (double click) gây đơn trùng
		let pendingRid = ''; // mã nội bộ của lần gửi hiện tại; gửi lại sau khi lỗi dùng lại đúng mã này để Sheet không ghi trùng

		function showDialog(state: 'loading' | 'ok' | 'err', title: string, text: string) {
			dlg.dataset.state = state;
			dlg.setAttribute('aria-busy', String(state === 'loading'));
			dlgTitle.textContent = title;
			dlgText.textContent = text;
			dlgClose.hidden = state === 'loading';
			if (!dlg.open) dlg.showModal();
			if (state !== 'loading') dlgClose.focus();
		}
		// Đang xử lý thì không cho đóng: chặn Esc, và nếu trình duyệt vẫn đóng thì mở lại
		dlg.addEventListener('cancel', (e) => submitting && e.preventDefault());
		dlg.addEventListener('close', () => submitting && dlg.showModal());
		dlgClose.addEventListener('click', () => dlg.close());

		// --- Ngày và khung giờ đón: tính theo GIỜ VIỆT NAM (không theo múi giờ máy khách) ---
		const LEAD_MS = 60 * 60 * 1000; // đặt trước tối thiểu 1 giờ
		const vnFmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Ho_Chi_Minh', year: 'numeric', month: '2-digit', day: '2-digit' });
		const vnToday = () => vnFmt.format(new Date()); // YYYY-MM-DD
		function addDays(iso: string, n: number) {
			const d = new Date(iso + 'T00:00:00Z');
			d.setUTCDate(d.getUTCDate() + n);
			return d.toISOString().slice(0, 10);
		}
		const slotTooSoon = (date: string, hhmm: string) => Date.parse(`${date}T${hhmm}:00+07:00`) - Date.now() < LEAD_MS;
		dateEl.min = vnToday();
		dateEl.max = addDays(vnToday(), 90);

		// Khung quá sát giờ vẫn chọn được nhưng hiện thông báo kèm hotline và không cho gửi
		function checkSoon() {
			const soon = !!(dateEl.value && timeEl.value && slotTooSoon(dateEl.value, timeEl.value));
			timeWarn.hidden = !soon;
			timeEl.setCustomValidity(soon ? (timeWarn.dataset.msg ?? '') : '');
			return soon;
		}
		function refreshSlots() {
			[...timeEl.options].forEach((o) => o.classList.toggle('soon', !!(o.value && dateEl.value && slotTooSoon(dateEl.value, o.value))));
			checkSoon();
		}
		dateEl.addEventListener('change', refreshSlots);
		timeEl.addEventListener('change', checkSoon);
		setInterval(refreshSlots, 60000);

		emailEl.addEventListener('input', () => emailEl.setCustomValidity(''));

		phone.addEventListener('input', () => phone.setCustomValidity(''));

		// Tạm tính theo số người (10+ thì để nhân viên báo giá)
		function updateEstimate() {
			const n = Number(people.value);
			estimate.textContent = Number.isFinite(n)
				? `${(n * Number(form.dataset.price)).toLocaleString(form.dataset.locale)} ${form.dataset.currency}`
				: (form.dataset.estimateMore ?? '');
		}
		people.addEventListener('change', updateEstimate);

		// --- gửi form về Google Sheet (Apps Script). Chỉ báo thành công khi Sheet xác nhận ĐÃ ghi xong ({ ok: true }) ---
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (submitting) return;
			const digits = phone.value.replace(/\D/g, '');
			phone.setCustomValidity(digits.length < 8 || digits.length > 15 ? (form.dataset.phoneErr ?? '') : '');
			const okEmail = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(emailEl.value.trim());
			emailEl.setCustomValidity(okEmail ? '' : (form.dataset.emailErr ?? ''));
			checkSoon();
			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}
			if (!pendingRid) pendingRid = 'R' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
			const data = { ...Object.fromEntries(new FormData(form).entries()), rid: pendingRid };
			if (data.website) return; // bot

			const endpoint = form.dataset.endpoint;
			const d = dlg.dataset;
			submitting = true;
			btn.disabled = true;
			showDialog('loading', d.processing ?? '', d.processingHint ?? '');
			const started = Date.now();
			try {
				if (!endpoint) {
					console.info('Booking (demo mode, not sent):', data);
					await new Promise((r) => setTimeout(r, 400));
				} else {
					// text/plain để tránh preflight CORS với Apps Script. Quá 30 giây hoặc Sheet trả ok:false thì báo lỗi.
					const ctl = new AbortController();
					const timer = setTimeout(() => ctl.abort(), 30000);
					try {
						const res = await fetch(endpoint, {
							method: 'POST',
							headers: { 'Content-Type': 'text/plain;charset=utf-8' },
							body: JSON.stringify(data),
							signal: ctl.signal,
						});
						const result = await res.json();
						if (!res.ok || result?.ok !== true) throw Object.assign(new Error('not saved'), { code: result?.error });
					} finally {
						clearTimeout(timer);
					}
				}
				// Hộp "đang xử lý" hiện tối thiểu 0,7 giây để khách kịp thấy, không nháy rồi tắt
				const rest = 700 - (Date.now() - started);
				if (rest > 0) await new Promise((r) => setTimeout(r, rest));
				submitting = false;
				pendingRid = '';
				showDialog('ok', d.okTitle ?? '', (endpoint ? form.dataset.ok : form.dataset.demo) ?? '');
				form.reset();
				refreshSlots();
				updateEstimate();
			} catch (e) {
				submitting = false;
				const code = (e as { code?: string }).code;
				showDialog('err', d.errTitle ?? '', code === 'too_soon' || code === 'invalid_slot' ? (timeWarn.dataset.msg ?? '') : (form.dataset.err ?? ''));
			} finally {
				submitting = false;
				btn.disabled = false;
			}
		});
	</script>
</Base>
